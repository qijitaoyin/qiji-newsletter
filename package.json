{
  "name": "qiji-newsletter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate_archive.ps1",
    "clean:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean_source_files.ps1",
    "sync:drive": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync_google_drive.ps1",
    "review:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply_review_publish.ps1",
    "assets:optimize": "node scripts/optimize_deploy_images.mjs",
    "ai:metadata": "node scripts/generate_ai_metadata.mjs",
    "check:ai-metadata": "node scripts/check_changed_ai_metadata.mjs",
    "check:tags": "node scripts/check_article_tags.mjs",
    "test:review-metadata": "node scripts/test_review_metadata_overrides.mjs",
    "test:word-images": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test_word_image_placement.ps1",
    "test:word-import": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test_word_import_signatures.ps1",
    "test:pixabay-images": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test_pixabay_image_rules.ps1",
    "test:review-legacy": "node scripts/test_review_legacy_visibility.mjs",
    "test:review-scope": "node scripts/test_scoped_review_import.mjs",
    "test:ai-metadata-check": "node scripts/test_changed_ai_metadata_check.mjs",
    "test:review-scope-sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test_review_import_scope.ps1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.9.2",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3"
  }
}
